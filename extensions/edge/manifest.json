{
  "manifest_version": 3,
  "name": "PS2 BIOS Checker",
  "version": "1.0.1",
  "description": "Select a local PS2 BIOS file to calculate MD5, SHA-1, and size in the browser. No upload.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PS2 BIOS Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": []
}
